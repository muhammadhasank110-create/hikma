]\\:cursor-e-resize {\n    [data-side=left][data-state=collapsed] & {\n      cursor: e-resize;\n    }\n  }\n  .\\[\\[data-side\\=right\\]\\[data-collapsible\\=offcanvas\\]_\\&\\]\\:-left-2 {\n    [data-side=right][data-collapsible=offcanvas] & {\n      left: calc(var(--spacing) * -2);\n    }\n  }\n  .\\[\\[data-side\\=right\\]\\[data-state\\=collapsed\\]_\\&\\]\\:cursor-w-resize {\n    [data-side=right][data-state=collapsed] & {\n      cursor: w-resize;\n    }\n  }\n  .\\[\\[data-slot\\=card-content\\]_\\&\\]\\:bg-transparent {\n    [data-slot=card-content] & {\n      background-color: transparent;\n    }\n  }\n  .\\[\\[data-slot\\=popover-content\\]_\\&\\]\\:bg-transparent {\n    [data-slot=popover-content] & {\n      background-color: transparent;\n    }\n  }\n  .\\[\\[data-slot\\=tooltip-content\\]_\\&\\]\\:bg-background\\/20 {\n    [data-slot=tooltip-content] & {\n      background-color: oklch(from rgb(var(--background)) l c h);\n      @supports (color: color-mix(in lab, red, red)) {\n        background-color: color-mix(in oklab, oklch(from rgb(var(--background)) l c h) 20%, transparent);\n      }\n    }\n  }\n  .\\[\\[data-slot\\=tooltip-content\\]_\\&\\]\\:text-background {\n    [data-slot=tooltip-content] & {\n      color: oklch(from rgb(var(--background)) l c h);\n    }\n  }\n  .dark\\:\\[\\[data-slot\\=tooltip-content\\]_\\&\\]\\:bg-background\\/10 {\n    @media (prefers-color-scheme: dark) {\n      [data-slot=tooltip-content] & {\n        background-color: oklch(from rgb(var(--background)) l c h);\n        @supports (color: color-mix(in lab, red, red)) {\n          background-color: color-mix(in oklab, oklch(from rgb(var(--background)) l c h) 10%, transparent);\n        }\n      }\n    }\n  }\n  .\\[\\[data-variant\\=legend\\]\\+\\&\\]\\:-mt-1\\.5 {\n    [data-variant=legend]+& {\n      margin-top: calc(var(--spacing) * -1.5);\n    }\n  }\n  .\\[a\\&\\]\\:hover\\:bg-accent {\n    a& {\n      &:hover {\n        @media (hover: hover) {\n          background-color: oklch(from rgb(var(--accent)) l c h);\n        }\n      }\n    }\n  }\n  .\\[a\\&\\]\\:hover\\:bg-destructive\\/90 {\n    a& {\n      &:hover {\n        @media (hover: hover) {\n          background-color: oklch(from rgb(var(--destructive)) l c h);\n          @supports (color: color-mix(in lab, red, red)) {\n            background-color: color-mix(in oklab, oklch(from rgb(var(--destructive)) l c h) 90%, transparent);\n          }\n        }\n      }\n    }\n  }\n  .\\[a\\&\\]\\:hover\\:bg-primary\\/90 {\n    a& {\n      &:hover {\n        @media (hover: hover) {\n          background-color: oklch(from rgb(var(--primary)) l c h);\n          @supports (color: color-mix(in lab, red, red)) {\n            background-color: color-mix(in oklab, oklch(from rgb(var(--primary)) l c h) 90%, transparent);\n          }\n        }\n      }\n    }\n  }\n  .\\[a\\&\\]\\:hover\\:bg-secondary\\/90 {\n    a& {\n      &:hover {\n        @media (hover: hover) {\n          background-color: oklch(from rgb(var(--secondary)) l c h);\n          @supports (color: color-mix(in lab, red, red)) {\n            background-color: color-mix(in oklab, oklch(from rgb(var(--secondary)) l c h) 90%, transparent);\n          }\n        }\n      }\n    }\n  }\n  .\\[a\\&\\]\\:hover\\:text-accent-foreground {\n    a& {\n      &:hover {\n        @media (hover: hover) {\n          color: oklch(from rgb(var(--accent-foreground)) l c h);\n        }\n      }\n    }\n  }\n}\n@property --tw-animation-delay {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0s;\n}\n@property --tw-animation-direction {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: normal;\n}\n@property --tw-animation-duration {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-animation-fill-mode {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: none;\n}\n@property --tw-animation-iteration-count {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-enter-blur {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-enter-opacity {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-enter-rotate {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-enter-scale {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-enter-translate-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-enter-translate-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-exit-blur {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-exit-opacity {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-exit-rotate {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-exit-scale {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-exit-translate-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-exit-translate-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@layer base {\n  :root, [data-theme=\"light\"] {\n    --forest: 28 70 32;\n    --forest-deep: 22 50 24;\n    --forest-mid: 45 100 55;\n    --forest-light: 237 240 237;\n    --maroon: 124 18 48;\n    --maroon-deep: 90 10 30;\n    --maroon-light: 250 235 238;\n    --clay: 136 90 68;\n    --clay-light: 201 153 126;\n    --sage: 210 218 200;\n    --cream: 250 248 243;\n    --canvas: 255 255 255;\n    --ink: 22 22 22;\n    --ink-muted: 80 80 80;\n    --ink-faint: 140 140 140;\n    --border: 195 195 188;\n    --border-strong: 150 150 143;\n    --background: var(--cream);\n    --foreground: var(--ink);\n    --card: 255 255 255;\n    --card-foreground: var(--ink);\n    --popover: 255 255 255;\n    --popover-foreground: var(--ink);\n    --primary: var(--forest);\n    --primary-foreground: 255 255 255;\n    --secondary: 210 218 200;\n    --secondary-foreground: 22 22 22;\n    --muted: 215 220 208;\n    --muted-foreground: 50 55 50;\n    --accent: var(--maroon);\n    --accent-foreground: 255 255 255;\n    --destructive: 220 38 38;\n    --destructive-foreground: 255 255 255;\n    --success: 21 128 61;\n    --success-foreground: 255 255 255;\n    --warning: 161 98 7;\n    --warning-foreground: 255 255 255;\n    --ring: var(--forest);\n    --radius: 0.5rem;\n    --arrival-rail: var(--maroon);\n    --audio-accent: var(--clay);\n    --focus-dim: 0 0 0;\n    --earcon-color: var(--clay);\n    --progress-fill: var(--forest);\n    --progress-track: var(--sage);\n    --lesson-surface: var(--cream);\n    --nav-bg: 30 62 34;\n    --nav-fg: 255 255 255;\n    --nav-active: var(--maroon);\n    --font-scale: 1;\n    --user-line-height: 1.7;\n    --user-letter-spacing: 0em;\n    --user-word-spacing: 0em;\n    --user-measure: 65ch;\n    --target-min: 44px;\n    --target-gap: 8px;\n    --duration-fast: 150ms;\n    --duration-base: 250ms;\n    --duration-slow: 350ms;\n    --dur-fast: 150ms;\n    --dur-base: 250ms;\n    --dur-slow: 350ms;\n    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);\n    --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  [data-theme=\"dark\"] {\n    --ring: 80 140 85;\n    --background: 24 38 26;\n    --foreground: 240 242 238;\n    --card: 32 50 34;\n    --card-foreground: 240 242 238;\n    --popover: 32 50 34;\n    --popover-foreground: 240 242 238;\n    --primary: 80 140 85;\n    --primary-foreground: 255 255 255;\n    --secondary: 45 65 48;\n    --secondary-foreground: 200 215 202;\n    --muted: 45 65 48;\n    --muted-foreground: 150 170 152;\n    --accent: 160 55 75;\n    --accent-foreground: 255 255 255;\n    --border: 55 80 58;\n    --border-strong: 90 115 93;\n    --ink: 240 240 235;\n    --ink-muted: 160 170 160;\n    --ink-faint: 100 110 100;\n    --nav-bg: 18 30 20;\n    --lesson-surface: 28 44 30;\n  }\n  [data-theme=\"cream\"] {\n    --ring: 28 70 32;\n    --background: 250 248 243;\n    --foreground: 30 25 20;\n    --card: 255 253 248;\n    --card-foreground: 30 25 20;\n    --border: 220 210 195;\n    --border-strong: 180 165 145;\n    --muted: 242 238 228;\n    --muted-foreground: 100 90 75;\n    --lesson-surface: 255 253 248;\n    --ink: 30 25 20;\n    --ink-muted: 100 90 75;\n  }\n  [data-theme=\"calm\"] {\n    --ring: 60 100 65;\n    --background: 242 244 242;\n    --foreground: 35 40 35;\n    --card: 248 250 248;\n    --card-foreground: 35 40 35;\n    --primary: 60 100 65;\n    --primary-foreground: 255 255 255;\n    --border: 210 215 210;\n    --border-strong: 170 175 170;\n    --muted: 235 238 235;\n    --muted-foreground: 90 100 90;\n    --lesson-surface: 248 250 248;\n    --arrival-rail: 90 10 30;\n  }\n  [data-theme=\"high_contrast\"] {\n    --background: 0 0 0;\n    --foreground: 255 255 255;\n    --card: 0 0 0;\n    --card-foreground: 255 255 255;\n    --primary: 0 255 0;\n    --primary-foreground: 0 0 0;\n    --secondary: 30 30 30;\n    --secondary-foreground: 255 255 255;\n    --muted: 20 20 20;\n    --muted-foreground: 200 200 200;\n    --accent: 255 255 0;\n    --accent-foreground: 0 0 0;\n    --border: 255 255 255;\n    --border-strong: 255 255 255;\n    --ring: 255 255 0;\n    --arrival-rail: 255 255 0;\n    --nav-bg: 0 0 0;\n    --nav-fg: 255 255 255;\n    --lesson-surface: 0 0 0;\n    --ink: 255 255 255;\n    --ink-muted: 200 200 200;\n  }\n  [data-font=\"atkinson\"] {\n    --font-body: \"Atkinson Hyperlegible\", system-ui, sans-serif;\n    --font-display: \"Atkinson Hyperlegible\", system-ui, sans-serif;\n  }\n  [data-font=\"plex\"] {\n    --font-body: \"IBM Plex Sans\", system-ui, sans-serif;\n    --font-display: \"IBM Plex Sans\", system-ui, sans-serif;\n  }\n  [data-font=\"opendyslexic\"] {\n    --font-body: \"OpenDyslexicRegular\", \"OpenDyslexic\", system-ui, sans-serif;\n    --font-display: \"OpenDyslexicRegular\", \"OpenDyslexic\", system-ui, sans-serif;\n  }\n  [data-font=\"naskh\"] {\n    --font-body: \"Noto Naskh Arabic\", \"Amiri\", serif;\n    --font-display: \"Amiri\", \"Noto Naskh Arabic\", seri